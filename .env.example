# Copier vers .env (jamais committer)

GASOIL_DOMAIN=gasoil-tracking.delhomme.ovh
GASOIL_HOST_PORT=3340

PORTAINER_URL=https://portainer.delhomme.ovh
PORTAINER_USERNAME=
PORTAINER_PASSWORD=
PORTAINER_ACCESS_TOKEN=

NPM_URL=https://nginx.delhomme.ovh
NPM_EMAIL=
NPM_PASSWORD=

JWT_SECRET=
APP_VERSION=1.0.1
ADMIN_EMAIL=admin@delhomme.ovh
# Mot de passe admin (créé au démarrage API si le compte n’existe pas)
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=0
ADMIN_NAME=Admin

# Inscription fermée : code obligatoire dans l'app
INVITE_CODE=

# Token machine pour upload APK automatique (GitHub Actions)
RELEASE_UPLOAD_TOKEN=

# SMTP — email de vérification d'inscription
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gasoil Tracking <noreply@maily.ovh>"
SMTP_SECURE=false
